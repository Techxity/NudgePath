# ── Required ──────────────────────────────────────────────
# Public URL of the app (no trailing slash)
BETTER_AUTH_URL=http://localhost:3000
# Long random string: `openssl rand -base64 32`
BETTER_AUTH_SECRET=

# Database: local file for dev, Turso (free) for production
DATABASE_URL=file:./data/nudgepath.db
# DATABASE_URL=libsql://your-db.turso.io
DATABASE_AUTH_TOKEN=

# ── AI (all free tiers). Set at least one key. ────────────
# Tried in this order; the next one is used if one fails or is rate limited.
AI_PROVIDERS=gemini,groq,openrouter
GEMINI_API_KEY=          # https://aistudio.google.com/apikey
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=            # https://console.groq.com/keys
GROQ_MODEL=openai/gpt-oss-20b
OPENROUTER_API_KEY=      # https://openrouter.ai/keys
OPENROUTER_MODEL=google/gemma-4-31b-it:free
# Set to 1 to use canned answers (no keys needed) while developing
AI_MOCK=0

# ── Limits ────────────────────────────────────────────────
DAILY_CREDITS_PER_USER=20    # find roles=2, plan=3, resume=2, coach message=1
DAILY_CREDITS_GLOBAL=3000    # safety cap across all users per day

# ── Optional ──────────────────────────────────────────────
# Comma-separated emails that can open /admin
ADMIN_EMAILS=
# "Continue with Google" (free): https://console.cloud.google.com/apis/credentials
# Redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Live remote jobs from Remotive's public API (cached 12h). Set 0 to turn off.
LIVE_JOBS=1
